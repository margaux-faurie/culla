{
  "name": "culla",
  "version": "0.0.0",
  "private": true,
  "description": "Cull Nikon JPEG+NEF photos with a swipe UI, then apply keep/reject safely.",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "biome check && tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "dev:demo": "vite --mode demo",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --mode demo --host 127.0.0.1 --port 4173 --strictPort",
    "e2e": "playwright test",
    "tauri": "tauri",
    "gen:bindings": "node -e \"console.log('M1: bindings arrive with the first tauri-specta command (ADR 0019)')\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
}
